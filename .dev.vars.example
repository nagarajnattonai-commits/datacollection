# Development only. Production builds always ignore this flag.
LOCAL_DEMO=true
# Exact email trusted by the Sites authenticated identity:
ADMIN_EMAIL=
# Optional automatic transcription configuration:
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
WORKER_SECRET=
# Optional Supabase PostgreSQL connection. Local D1 is used when these are blank.
DATABASE_PROVIDER=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_WORKSPACE_ID=main
